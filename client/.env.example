# EduControl Client Environment Variables (Example Template)

# Внешний URL бэкенда (если не задан, используется относительный путь /api через встроенный прокси)
NEXT_PUBLIC_API_URL="/api"

# Внутренний URL бэкенда для серверного проксирования Next.js (по умолчанию http://127.0.0.1:5000)
INTERNAL_API_URL="http://127.0.0.1:5000"
