# EduControl Server Environment Variables (Example Template)
# Копируйте этот файл в .env и укажите ваши значения

# Порт бэкенда (внутри контейнера по умолчанию 5000)
PORT=5000

# Подключение к базе данных (по умолчанию локальный файл SQLite)
DATABASE_URL="file:./dev.db"

# Секретный ключ для подписи JWT-токенов (Сгенерируйте случайную строку из 32+ символов)
JWT_SECRET="replace-with-a-very-long-random-secret-key-32-chars-min"

# Время опоздания (формат HH:MM)
LATE_THRESHOLD_TIME="09:00"

# Разрешённый адрес фронтенда для CORS
CORS_ORIGIN="http://localhost:3000"
